# Copy to `.env` and fill in. NEVER commit a populated .env. All secrets are read
# from the environment by qlab.config — nothing is ever hard-coded in source.

# --- Backtest / cost knobs (optional; defaults shown) ---
QLAB_INITIAL_CASH=1000000
QLAB_OOS_FRACTION=0.3
QLAB_TRADING_DAYS=252
QLAB_COMMISSION_RATE=0.0005
QLAB_SLIPPAGE_BPS=1.0
QLAB_MIN_COMMISSION=0.0
QLAB_FIXTURES_DIR=fixtures
QLAB_ARTIFACTS_DIR=artifacts

# --- 指标口径 (户部 EVO-12 v1.0 §1-2; 门禁阈值 v1.0 固定, 不走 env) ---
QLAB_RISK_FREE_RATE=0.0          # r_f 年化 (取 0 报告会显式声明)
QLAB_MAR=0.0                     # Sortino 最低可接受收益 (年化)
QLAB_TURNOVER_DOUBLE_SIDED=false # 换手成交额双边口径
QLAB_CAPACITY_PARTICIPATION=0.10 # 单 bar 可参与成交量上限占比 (5%-10%)

# --- moomoo US OpenD (optional; leave disabled for fixture-only runs) ---
# OpenD runs locally; point host/port at your running gateway.
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_ENV=SIMULATE        # 模式隔离: SIMULATE | REAL
MOOMOO_SECURITY_FIRM=FUTUINC     # FUTUINC (US) | FUTUSG | FUTUHK
MOOMOO_ENABLED=false             # must be true to attempt ANY live call

# --- 安全栏杆 (EVO-13 §3; 默认全部 fail-safe) ---
MOOMOO_ALLOW_ORDERS=false        # 自动交易默认关闭; 下单路径必须显式打开
MOOMOO_ALLOW_REAL=false          # 实盘二次闸门; REAL 下单还需要这个为 true
MOOMOO_KILL_SWITCH_FILE=         # 全局急停哨兵文件路径 (存在即停所有下单)
MOOMOO_KILL_SWITCH=              # 或用环境变量急停 (1/true 即停)
MOOMOO_MAX_ORDERS=30             # 限频: 窗口内最多下单笔数
MOOMOO_ORDER_WINDOW_SEC=30       # 限频窗口秒数
MOOMOO_CONNECT_RETRIES=3         # 连接异常重连次数
MOOMOO_CONNECT_BACKOFF=0.5       # 重连退避基数秒

# Secrets — REQUIRED only when MOOMOO_ENABLED=true. Keep out of version control.
# NOTE: 旧 moomoo-bot 把 TRADING_PASSWORD/pwd_unlock 写死在源码并提交了 .env —
# 已彻底移除; 凭据只走以下环境变量, 且日志中一律脱敏。
MOOMOO_ACCOUNT_ID=
MOOMOO_UNLOCK_PWD=               # trade unlock password (REAL env only)
