{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multica.local/schemas/llm_paper_mwf_v2_settlement.schema.json",
  "title": "LLM paper M/W/F v2 settlement artifact",
  "type": "object",
  "required": [
    "schema", "experiment_version", "cell_id", "scheduled_at", "execution_key", "settlement_key",
    "returns_through", "data_available_through", "benchmark_returns_through",
    "rejected_keys", "turnover_notional", "cost_rate", "entry_cost",
    "reading_kind", "is_performance_reading", "is_acceptance_reading",
    "round_inputs", "archive_inputs", "resolution_inputs", "content_sha256"
  ],
  "properties": {
    "schema": {"const": "llm_paper_settlement/v2"},
    "experiment_version": {"type": "string"},
    "cell_id": {"type": "string", "minLength": 1},
    "scheduled_at": {"type": "string", "format": "date-time"},
    "execution_key": {"type": "array", "minItems": 3, "maxItems": 3},
    "settlement_key": {"type": "array", "minItems": 7, "maxItems": 7},
    "returns_through": {"type": ["string", "null"]},
    "data_available_through": {"type": ["string", "null"]},
    "benchmark_returns_through": {"type": ["string", "null"]},
    "rejected_keys": {"type": "array", "items": {"type": "object"}},
    "turnover_notional": {"type": "number", "minimum": 0},
    "cost_rate": {"const": 0.001},
    "entry_cost": {"type": "number", "minimum": 0},
    "reading_kind": {"enum": ["equivalence_artifact", "lower_bound", "acceptance"]},
    "is_performance_reading": {"type": "boolean"},
    "is_acceptance_reading": {"type": "boolean"},
    "round_inputs": {"$ref": "#/$defs/hashedInputs"},
    "archive_inputs": {"$ref": "#/$defs/hashedInputs"},
    "resolution_inputs": {"$ref": "#/$defs/hashedInputs"},
    "acceptance_equity_inputs": {"$ref": "#/$defs/frozenSourceInputs"},
    "acceptance_cash_inputs": {"$ref": "#/$defs/frozenSourceInputs"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "hashedInputs": {
      "type": "array",
      "items": {
        "type": "object", "required": ["file", "content_sha256"],
        "properties": {
          "file": {"type": "string"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "frozenSourceInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file", "input_kind", "source_identity", "source_time_utc",
          "evidence_available_utc", "coverage", "raw_file_sha256",
          "source_query", "content_sha256"
        ],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "input_kind": {"enum": ["opend_k_day_qfq", "bil_total_return"]},
          "source_identity": {"type": "string", "minLength": 1},
          "source_time_utc": {"type": "string", "format": "date-time"},
          "evidence_available_utc": {"type": "string", "format": "date-time"},
          "coverage": {"type": "object"},
          "raw_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_query": {"type": "object"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "reading_kind": {"const": "lower_bound"},
          "is_acceptance_reading": {"const": true}
        },
        "required": ["reading_kind", "is_acceptance_reading"]
      }
    },
    {
      "if": {"properties": {"reading_kind": {"const": "acceptance"}}},
      "then": {
        "required": ["acceptance_equity_inputs", "acceptance_cash_inputs"],
        "properties": {
          "acceptance_equity_inputs": {"minItems": 1},
          "acceptance_cash_inputs": {"minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": true
}
