{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multica.local/schemas/llm_paper_mwf_v2_input.schema.json",
  "title": "LLM paper M/W/F v2 content-addressed typed input",
  "type": "object",
  "required": [
    "schema", "input_kind", "source_identity", "file", "source_time_utc",
    "evidence_available_utc", "coverage", "records", "content_sha256"
  ],
  "properties": {
    "schema": {"const": "llm_paper_typed_input/v2"},
    "input_kind": {
      "enum": ["archive_snapshot", "resolution", "opend_k_day_qfq", "bil_total_return"]
    },
    "source_identity": {"type": "string", "minLength": 1},
    "file": {"type": "string", "minLength": 1},
    "source_time_utc": {"type": "string", "format": "date-time"},
    "evidence_available_utc": {"type": "string", "format": "date-time"},
    "coverage": {
      "type": "object",
      "required": ["symbols", "trade_dates"],
      "properties": {
        "symbols": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "trade_dates": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "format": "date"}
        }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "trade_date"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "trade_date": {"type": "string", "format": "date"},
          "open": {"type": "number", "exclusiveMinimum": 0},
          "close": {"type": "number", "exclusiveMinimum": 0},
          "ktype": {"type": "string"},
          "rehab_type": {"type": "string"},
          "total_return_factor": {"type": "number", "exclusiveMinimum": 0},
          "status": {"type": "string"},
          "authoritative_source": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
