__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
# Ad-hoc run outputs are ignored; curated sample + real-evidence dirs are kept.
reports/*
!reports/SAMPLE_paper_run/
!reports/opend_probe/
!reports/opend_session_live/
!reports/SAMPLE_events_synth/
!reports/simulate_evidence_summary/
# EVO-65 autopilot: each in-session SIMULATE window commits its own timestamped
# slot dir (opend_session_<ts>); aggregate_simulate.py folds them in by prefix.
!reports/opend_session_*/
data/cache/
*.parquet
# EVO-24: the delivered adjusted daily bars ARE committed (real OpenD qfq data)
# so the serial 真跑 step reads them from the branch without re-hitting the
# 30-day historical-K quota. Ad-hoc parquet elsewhere stays ignored.
!data/daily/*.parquet
