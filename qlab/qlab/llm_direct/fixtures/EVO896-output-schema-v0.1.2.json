      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_session": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "READY",
        "ABSTAIN"
