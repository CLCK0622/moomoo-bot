{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evo896:output:LLMCLI-v0.1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "arm_version",
    "snapshot_id",
    "input_sha256",
    "decision_session",
    "status",
    "reason_code",
    "ranked_symbols",
