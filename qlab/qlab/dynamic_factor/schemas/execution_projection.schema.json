{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EVO884.D1Projection/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_sha256", "NAV_anchor", "M", "P", "net_orders", "reasons", "trace"],
  "properties": {
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "NAV_anchor": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "M": {"$ref": "#/$defs/holdings"},
    "P": {"$ref": "#/$defs/holdings"},
    "net_orders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "side", "quantity", "priority"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "side": {"enum": ["SELL", "BUY"]},
          "quantity": {"type": "integer", "minimum": 1},
          "priority": {"type": "integer", "minimum": 1}
        }
      }
    },
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "trace": {"const": ["VALIDATE_AND_LOCK", "REQUIRED_M", "RAW_INTEGER_TARGET", "OTHER_REDUCTIONS", "SATELLITE_BUYS", "QQQ_BUY", "SEAL_SINGLE_P"]}
  },
  "$defs": {
    "holdings": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
  }
}
