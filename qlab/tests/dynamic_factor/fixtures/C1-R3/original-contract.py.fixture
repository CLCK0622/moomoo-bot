"""Deterministic JSON envelopes and byte fingerprints shared by every tool."""

from __future__ import annotations

import hashlib
import inspect
import json
import math
from pathlib import Path


def clean(value):
    """Retain nonfinite observations as null; never turn unknowns into zero."""
    if isinstance(value, float) and not math.isfinite(value):
        return None
    if isinstance(value, dict):
        return {str(k): clean(v) for k, v in value.items()}
    if isinstance(value, (tuple, list)):
        return [clean(v) for v in value]
    return value


def canonical(value) -> bytes:
    return json.dumps(
        clean(value),
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
        allow_nan=False,
    ).encode("utf-8")


def sha256(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def digest(value) -> str:
    return sha256(canonical(value))


def is_sha(value) -> bool:
    return (
        isinstance(value, str)
        and len(value) == 64
        and all(c in "0123456789abcdef" for c in value)
    )


def source_manifest() -> dict:
    root = Path(__file__).parent
    return {p.name: sha256(p.read_bytes()) for p in sorted(root.glob("*.py"))}


def code_sha(value):
    """Hash the whole adapter module, including helpers and constants."""
    source = inspect.getsourcefile(value)
    if source is None:
        raise ValueError("adapter_source_unavailable")
    return sha256(Path(source).read_bytes())


def result(
    tool,
    inputs,
    *,
    metrics=None,
    reasons=(),
    missing=(),
    assumptions=(),
    availability=None,
    artifacts=None,
    certifiable=False,
    extra_sources=None,
):
    sources = source_manifest()
    sources.update(extra_sources or {})
    reasons = list(dict.fromkeys(reasons))
    return clean(
        {
            "schema": "dynamic_factor.tool/v1",
            "tool": tool,
            "ok": not reasons,
            "certifiable": bool(certifiable and not reasons),
            "runtime_consumable": False,
            "input_sha256": digest(inputs),
            "source_sha256": digest(sources),
            "source_files": sources,
            "assumptions": list(assumptions),
            "missing_inputs": list(missing),
            "reasons": reasons,
            "metrics": metrics or {},
            "metric_availability": availability or {},
            "artifacts": artifacts or {},
        }
    )


def unavailable(reason):
    return {"available": False, "reason": reason}

REVIEW_original_read = Path.read_bytes
REVIEW_original_contract = b'"""Deterministic JSON envelopes and byte fingerprints shared by every tool."""\n\nfrom __future__ import annotations\n\nimport hashlib\nimport inspect\nimport json\nimport math\nfrom pathlib import Path\n\n\ndef clean(value):\n    """Retain nonfinite observations as null; never turn unknowns into zero."""\n    if isinstance(value, float) and not math.isfinite(value):\n        return None\n    if isinstance(value, dict):\n        return {str(k): clean(v) for k, v in value.items()}\n    if isinstance(value, (tuple, list)):\n        return [clean(v) for v in value]\n    return value\n\n\ndef canonical(value) -> bytes:\n    return json.dumps(\n        clean(value),\n        sort_keys=True,\n        separators=(",", ":"),\n        ensure_ascii=False,\n        allow_nan=False,\n    ).encode("utf-8")\n\n\ndef sha256(value: bytes) -> str:\n    return hashlib.sha256(value).hexdigest()\n\n\ndef digest(value) -> str:\n    return sha256(canonical(value))\n\n\ndef is_sha(value) -> bool:\n    return (\n        isinstance(value, str)\n        and len(value) == 64\n        and all(c in "0123456789abcdef" for c in value)\n    )\n\n\ndef source_manifest() -> dict:\n    root = Path(__file__).parent\n    return {p.name: sha256(p.read_bytes()) for p in sorted(root.glob("*.py"))}\n\n\ndef code_sha(value):\n    """Hash the whole adapter module, including helpers and constants."""\n    source = inspect.getsourcefile(value)\n    if source is None:\n        raise ValueError("adapter_source_unavailable")\n    return sha256(Path(source).read_bytes())\n\n\ndef result(\n    tool,\n    inputs,\n    *,\n    metrics=None,\n    reasons=(),\n    missing=(),\n    assumptions=(),\n    availability=None,\n    artifacts=None,\n    certifiable=False,\n    extra_sources=None,\n):\n    sources = source_manifest()\n    sources.update(extra_sources or {})\n    reasons = list(dict.fromkeys(reasons))\n    return clean(\n        {\n            "schema": "dynamic_factor.tool/v1",\n            "tool": tool,\n            "ok": not reasons,\n            "certifiable": bool(certifiable and not reasons),\n            "runtime_consumable": False,\n            "input_sha256": digest(inputs),\n            "source_sha256": digest(sources),\n            "source_files": sources,\n            "assumptions": list(assumptions),\n            "missing_inputs": list(missing),\n            "reasons": reasons,\n            "metrics": metrics or {},\n            "metric_availability": availability or {},\n            "artifacts": artifacts or {},\n        }\n    )\n\n\ndef unavailable(reason):\n    return {"available": False, "reason": reason}\n'
def REVIEW_contract_read(path):
    if path.name == "contract.py":
        return REVIEW_original_contract
    return REVIEW_original_read(path)
Path.read_bytes = REVIEW_contract_read
